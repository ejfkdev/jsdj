# ===== Dependencies =====
node_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/cache
.yarn/install-state.gz
jspm_packages/

# ===== Build output =====
# `dist/` is generated by `npm run build` and shipped via `npm publish`.
# It is not committed: the build is reproducible and reviewing compiled JS
# alongside its source is noise.
dist/
*.tsbuildinfo
*.tgz

# ===== Test and coverage output =====
coverage/
.nyc_output/
test-results/
*.lcov

# ===== Examples =====
# Each example is an independent project that installs this package from the
# parent (`file:../..`), so its node_modules and lockfile are per-example.
examples/*/node_modules/
examples/*/dist/
examples/*/package-lock.json
# Recordings produced by 03-custom-transport; the script regenerates them, and a
# committed one would rot as the fixture changes.
examples/*/recording.json
examples/*/out/
examples/*/.cache/

# ===== Logs and diagnostics =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-error.log

# ===== Environment =====
# Never commit credentials or local overrides.
.env
.env.local
.env.*.local
.envrc

# ===== Editors =====
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
# Emacs
*.#*
\#*\#
# Vim
.netrwhist

# ===== OS =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===== Local scratch =====
# Loose directories used during development; nothing here is part of the project.
tmp/
out/
scratch/
*.local
